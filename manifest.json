{
  "manifest_version": 3,
  "default_locale": "id",
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.0.5",
  "description": "__MSG_appDescription__",
  "homepage_url": "https://yudadwiptr.github.io/privacywaweb/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appShortName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["shared/defaults.js", "shared/lock.js", "content/content.js", "content/lock.js", "content/diagnose.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-tirai": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "__MSG_cmdToggle__"
    },
    "lock-now": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_cmdLock__"
    }
  }
}
